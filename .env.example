# Astronomia Magazine Environment Configuration
# Free tiers only. No paid APIs required.

# NASA Open API Key
# Optional: Defaults to 'DEMO_KEY' if not provided (30 requests/hour, 50 requests/day).
# Generate a free high-rate key (1,000 req/hr) instantly at: https://api.nasa.gov
NASA_API_KEY=DEMO_KEY

# Optional secret token to protect background /api/sync endpoint triggers (e.g., cron jobs)
SYNC_SECRET=your_cosmic_sync_secret_token_here

# Optional: Public site URL for OpenGraph and canonical links
NEXT_PUBLIC_SITE_URL=https://space-blog.vercel.app
